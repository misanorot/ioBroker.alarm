{
    // The shared panel has no dependencies of its own: it is compiled as part of ../src-widgets
    // and ../src-devices, each with its own copy of React and MUI. This file exists so that an
    // editor - and the type-aware eslint rules of the repository - still see these files as a
    // TypeScript project, and it takes the types from the widget set, which is installed first.
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "allowJs": false,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "types": ["@iobroker/types"],
        "paths": {
            "react": ["../src-widgets/node_modules/@types/react"],
            "react/*": ["../src-widgets/node_modules/@types/react/*"],
            "@mui/material": ["../src-widgets/node_modules/@mui/material"],
            "@mui/material/*": ["../src-widgets/node_modules/@mui/material/*"],
            "@mui/icons-material": ["../src-widgets/node_modules/@mui/icons-material"],
            "@mui/icons-material/*": ["../src-widgets/node_modules/@mui/icons-material/*"],
            "@iobroker/gui-components": ["../src-widgets/node_modules/@iobroker/gui-components"],
            "@iobroker/types": ["../src-widgets/node_modules/@iobroker/types"]
        }
    },
    "include": ["src"]
}
