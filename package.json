{
    "name": "iobroker.alarm",
    "version": "5.0.2",
    "description": "Your own lttle alarm system",
    "author": {
        "name": "misanorot",
        "email": "audi16v@gmx.de"
    },
    "homepage": "https://github.com/misanorot/ioBroker.alarm",
    "license": "MIT",
    "keywords": [
        "alarm system",
        "security",
        "protection",
        "ioBroker"
    ],
    "repository": {
        "type": "git",
        "url": "git@github.com:misanorot/ioBroker.alarm.git"
    },
    "engines": {
        "node": ">= 22.19.0"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "node-schedule": "^2.1.2",
        "suncalc2": "^1.8.1"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.1",
        "@iobroker/types": "^7.2.5",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^22.20.5",
        "@types/node-schedule": "^2.1.8",
        "@types/suncalc": "^1.9.2",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "build/",
        "widgets/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "rimraf build",
        "build": "npm run build:backend && tsx tasks.ts && npm run build:widgets && npm run build:devices",
        "build:widgets": "tsx tasks.ts --widgets",
        "build:devices": "tsx tasks.ts --devices",
        "build:backend": "tsc -p tsconfig.build.json",
        "watch": "tsc -p tsconfig.build.json --watch",
        "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
        "test:package": "mocha test/package --exit",
        "test:integration": "mocha test/integration --exit",
        "test": "npm run test:js && npm run test:package",
        "check": "tsc --noEmit -p tsconfig.json",
        "check:widgets": "npm --prefix src-widgets run typecheck",
        "check:devices": "npm --prefix src-devices run typecheck",
        "lint": "eslint -c eslint.config.mjs .",
        "translate": "translate-adapter",
        "release": "release-script",
        "npm": "npm i && cd src-admin && npm i -f && cd ../src-widgets && npm i && cd ../src-devices && npm i",
        "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade && cd ../src-widgets && npx -y npm-check-updates --upgrade && cd ../src-devices && npx -y npm-check-updates --upgrade"
    },
    "bugs": {
        "url": "https://github.com/misanorot/ioBroker.alarm/issues"
    },
    "readmeFilename": "README.md"
}
